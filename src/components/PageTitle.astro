---
import { Icon } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';

const { wip } = Astro.locals.starlightRoute.entry.data as { wip?: boolean | string };

const DEFAULT_WIP_MESSAGE =
	'👷 This page is currently still under development; please check back in later! 🐶';

const wipMessage = wip === true ? DEFAULT_WIP_MESSAGE : wip || undefined;
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{wipMessage && (
	<p class="wip-notice sl-flex">
		<Icon name="warning" size="1.5em" color="var(--sl-color-orange-high)" />
		<span>{wipMessage}</span>
	</p>
)}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.wip-notice {
			border: 1px solid var(--sl-color-orange);
			padding: 0.75em 1em;
			background-color: var(--sl-color-orange-low);
			color: var(--sl-color-orange-high);
			width: max-content;
			max-width: 100%;
			align-items: center;
			gap: 0.75em;
			font-size: var(--sl-text-body-sm);
			line-height: var(--sl-line-height-headings);
			text-align: start;
			margin-top: 0.75rem;
		}
	}
</style>
