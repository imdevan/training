---
import { faSun, faMoon, faDesktop } from '@fortawesome/free-solid-svg-icons';
import { icon as renderIcon } from '@fortawesome/fontawesome-svg-core';

const icons = {
	light: renderIcon(faSun)?.html.join('') || '',
	dark: renderIcon(faMoon)?.html.join('') || '',
	auto: renderIcon(faDesktop)?.html.join('') || '',
};
---

<button
	type="button"
	class="theme-toggle"
	id="theme-toggle"
	aria-label="Toggle color theme"
	data-icons={JSON.stringify(icons)}
></button>

{/* Inlined to avoid FOUC. Uses global scope from ThemeProvider.astro */}
<script is:inline>
	(() => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const icons = JSON.parse(btn.dataset.icons || '{}');
		const storageKey = 'starlight-theme';
		const order = ['dark', 'light', 'auto'];

		const parseTheme = (theme) =>
			theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

		const loadTheme = () =>
			parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

		const storeTheme = (theme) => {
			if (typeof localStorage !== 'undefined') {
				localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
			}
		};

		const getPreferredColorScheme = () =>
			matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

		function render(theme) {
			btn.innerHTML = icons[theme] || '';
			btn.setAttribute('aria-label', 'Color theme: ' + theme);
		}

		function applyTheme(theme) {
			document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
			window.StarlightThemeProvider?.updatePickers(theme);
			storeTheme(theme);
			render(theme);
		}

		btn.addEventListener('click', () => {
			const current = loadTheme();
			const next = order[(order.indexOf(current) + 1) % order.length];
			applyTheme(next);
		});

		matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
			if (loadTheme() === 'auto') applyTheme('auto');
		});

		render(loadTheme());
	})();
</script>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		border-radius: 0.5rem;
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	.theme-toggle :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}
</style>
