---
import { slugify } from '../utils/slugify';

interface Props {
  title: string;
  id?: string;
  subtitle?: string;
  blurb?: string;
  usefulFor?: string;
  howToTrain?: string;
  nonVerbal?: string;
  open?: boolean;
  draft?: boolean;
}

const { title, subtitle, blurb, usefulFor, howToTrain, nonVerbal, open = false, draft = false } = Astro.props;
const id = Astro.props.id ?? slugify(title);
---

{!draft && (
  <details id={id} class:list={['cue-accordion', { 'is-open': open }]} open={open}>
    <summary>
      <h4 style="display: inline; font-size: inherit; font-weight: bold; margin: 0;"><span class="cue-title-text"><span class="cue-quote-wrap cue-quote-open" aria-hidden="true"><span class="cue-quote-inner">&ldquo;</span></span>{title}<span class="cue-quote-wrap cue-quote-close" aria-hidden="true"><span class="cue-quote-inner">&rdquo;</span></span></span></h4>
      {subtitle && <span class="cue-subtitle">{subtitle}</span>}
    </summary>
    <div class="cue-content-wrapper" aria-hidden={!open}>
      <div class="cue-content-inner">
        {blurb && (
          <p>{blurb}</p>
        )}
        {usefulFor && (
          <div>
            <h5>When it is useful</h5>
            <p>{usefulFor}</p>
          </div>
        )}
        {howToTrain && (
          <div>
            <h5>High level how to train</h5>
            <p>{howToTrain}</p>
          </div>
        )}
        {nonVerbal && (
          <div>
            <h5>Non-verbal cue</h5>
            <p>{nonVerbal}</p>
          </div>
        )}
        <slot />
      </div>
    </div>
  </details>
)}

<style>
  details.cue-accordion summary {
    display: flex !important;
    align-items: center;
    width: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .cue-title-text {
    display: inline-block;
    transform: translateX(0);
    transition: transform 300ms cubic-bezier(0, 0, 0.2, 1);
  }

  .cue-quote-wrap {
    display: inline-grid;
    grid-template-columns: 0fr;
    vertical-align: top;
    transition: grid-template-columns 300ms cubic-bezier(0, 0, 0.2, 1);
  }

  .cue-quote-inner {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 300ms cubic-bezier(0, 0, 0.2, 1);
  }

  .cue-quote-open .cue-quote-inner {
    padding-right: 0.15em;
  }

  .cue-quote-close .cue-quote-inner {
    padding-left: 0.15em;
  }

  details.cue-accordion.is-open .cue-title-text {
    transform: translateX(0.35em);
  }

  details.cue-accordion.is-open .cue-quote-wrap {
    grid-template-columns: 1fr;
  }

  details.cue-accordion.is-open .cue-quote-inner {
    opacity: 1;
  }

  .cue-subtitle {
    margin-left: auto;
    padding-left: 1rem;
    color: var(--muted-foreground);
    opacity: 0.7;
    font-weight: inherit;
    font-size: 0.875em;
    text-align: right;
    white-space: nowrap;
  }
</style>

<script>
  import { initAccordions } from '../scripts/accordion';

  initAccordions();
  document.addEventListener('astro:page-load', initAccordions);
</script>
