---
interface Props {
  title: string;
  blurb?: string;
  usefulFor?: string;
  howToTrain?: string;
  nonVerbal?: string;
  open?: boolean;
}

const { title, blurb, usefulFor, howToTrain, nonVerbal, open = false } = Astro.props;
---

<details open={open}>
  <summary><h4 style="display: inline; font-size: inherit; font-weight: bold; margin: 0;">{title}</h4></summary>
  <div style="margin-top: 0.75rem;">
    {blurb && (
      <p>{blurb}</p>
    )}
    {usefulFor && (
      <div>
        <h5>When it is useful</h5>
        <p>{usefulFor}</p>
      </div>
    )}
    {howToTrain && (
      <div>
        <h5>High level how to train</h5>
        <p>{howToTrain}</p>
      </div>
    )}
    {nonVerbal && (
      <div>
        <h5>Non-verbal cue</h5>
        <p>{nonVerbal}</p>
      </div>
    )}
    <slot />
  </div>
</details>
